APP_NAME="FireShark Community"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://community.fireshark.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Database (MySQL on Hostinger) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fireshark_community
DB_USERNAME=fireshark_community
DB_PASSWORD=

# ---- Session / cache (database drivers: no Redis needed) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=fireshark.in
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Mail (configure with Hostinger SMTP before launch) ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=community@fireshark.in
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="community@fireshark.in"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Frontend ----
# In production the compiled SPA is served by Laravel from the same origin,
# so this equals APP_URL. During local development set it to http://localhost:5173.
FRONTEND_URL=https://community.fireshark.in

# Set to false ONLY if outgoing mail is not yet configured at launch.
REQUIRE_EMAIL_VERIFICATION=true

# Sanctum SPA cookie authentication (comma-separated, no scheme).
# Production (single origin): community.fireshark.in
# Local development: localhost:5173,localhost:8000
SANCTUM_STATEFUL_DOMAINS=community.fireshark.in
