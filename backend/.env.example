APP_NAME="FireShark Community"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://community.fireshark.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=error

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fireshark_community
DB_USERNAME=fireshark_community
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=fireshark.in
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------
# Mail / ZeptoMail configuration
# ------------------------------
MAIL_MAILER=zeptomail
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=587
MAIL_USERNAME=zeptomail
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="community@fireshark.in"
MAIL_FROM_NAME="${APP_NAME}"

ZEPTOMAIL_API_KEY=your_zeptomail_api_key_here
ZEPTOMAIL_API_BASE=https://api.zeptomail.in/v1.1
ZEPTOMAIL_FROM_EMAIL=community@fireshark.in
ZEPTOMAIL_FROM_NAME="FireShark Community"
ZEPTOMAIL_OTP_TEMPLATE_KEY=your_otp_template_key
ZEPTOMAIL_RESET_TEMPLATE_KEY=your_reset_template_key

# ------------------------------
# Turnstile CAPTCHA configuration
# ------------------------------
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ENFORCE_IN_LOCAL=false

# ------------------------------
# Frontend / SPA configuration
# ------------------------------

# ------------------------------
# Community settings
# ------------------------------
REQUIRE_EMAIL_VERIFICATION=true
SITE_NAME="FireShark Community"
SITE_DESCRIPTION="A technical community for cybersecurity professionals, learners, ethical hackers and technology enthusiasts."
SUPPORT_URL=https://fireshark.in/

# ------------------------------
# Security / Rate limits
# ------------------------------
# These are configured via Laravel's rate limiter in AppServiceProvider
# auth: 10/min per IP, 5/min per email
# register: 5/hr per IP, 3/hr per email
# write (ask/answer/comment/vote): 20/min per user
# otp.verify: 10/min per IP + per identifier
# otp.resend: 3/min per IP, 8/hr per identifier
# username.check: 20/min per IP
# search: 30/min
# reports: 5/min

# Global email budget (enforced by EmailBudgetService)
# EMAIL_BUDGET_HOURLY=500
# EMAIL_BUDGET_DAILY=5000
